# Port the function runs on (defaults to 8080 if not set)
PORT=8080

# Comma-separated list of storefront health check endpoints to monitor
STOREFRONT_HEALTH_CHECK_ENDPOINTS=https://api1.example.com/health,https://api2.example.com/health

# Comma-separated list of search health check endpoints to monitor
SEARCH_HEALTH_CHECK_ENDPOINTS=https://search-api.example.com/health

# Optional: per-request timeout in milliseconds, applied to all namespaces
# (omit for no timeout)
# HEALTH_CHECK_TIMEOUT_MS=5000
